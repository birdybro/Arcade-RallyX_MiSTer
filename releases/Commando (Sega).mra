<misterromdescription>
	<name>Commando (Sega)</name>
	<setname>commsega</setname>
	<rbf>rallyx</rbf>
	<mameversion>0262</mameversion>
	<year>1983</year>
	<manufacturer>Sega</manufacturer>
	<category>Maze</category>
	<rotation>vertical (cw)</rotation>
	<resolution>15kHz</resolution>
	<players>2</players>
	<joystick>4-way</joystick>
	<num_buttons>2</num_buttons>
	<buttons names="Fire,Fire 2,Start 1P,Start 2P,Coin,Pause" default="A,B,Start,Select,R,L"/>

	<!-- DIP word: byte0 = DSW1 (bit7 P1-down live, bit6 = Fire1 live), byte1 = DSW2 -->
	<switches default="FF,FF">
		<dip name="Coin B"        bits="0,2"  ids="Free Play,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,2C/1C,1C/1C"/>
		<dip name="Infinite Lives" bits="3"   ids="On,Off"/>
		<dip name="Lives"         bits="8,9"  ids="6,5,4,3"/>
		<dip name="Coin A"        bits="10,12" ids="Free Play,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,2C/1C,1C/1C"/>
		<dip name="Difficulty"    bits="14"   ids="Hard (24),Easy (16)"/>
		<dip name="Cabinet"       bits="15"   ids="Upright,Cocktail"/>
	</switches>

	<!-- game-select byte: 5 = Commando (must precede the main ROM) -->
	<rom index="1"><part>05</part></rom>

	<rom index="0" md5="none" zip="commsega.zip">
		<!-- maincpu @ 0x0000 -->
		<part crc="92de3405" name="csega1"/>
		<part crc="f14e2f9a" name="csega2"/>
		<part crc="941dbf48" name="csega3"/>
		<part crc="e0ac69b4" name="csega4"/>
		<part crc="bc56ebd0" name="csega5"/>
		<part repeat="0x3000">FF</part>
		<!-- gfx1 (chars/sprites) @ 0x8000  (csega7 then csega6) -->
		<part crc="e8e374f9" name="csega7"/>
		<part crc="cf07fd5e" name="csega6"/>
		<!-- gfx2 (radar dots) @ 0xA000 -->
		<part crc="ae7fd962" name="gg3.bpr"/>
		<part repeat="0xF00">FF</part>
		<!-- palette PROM @ 0xB000 -->
		<part crc="f69e585a" name="gg1.bpr"/>
		<part repeat="0xE0">FF</part>
		<!-- colour lookup PROM @ 0xB100 -->
		<part crc="0b756e30" name="gg2.bpr"/>
		<part repeat="0xE00">FF</part>
		<!-- sound CPU ROM @ 0xC000 -->
		<part crc="588b4210" name="csega8"/>
	</rom>
</misterromdescription>
